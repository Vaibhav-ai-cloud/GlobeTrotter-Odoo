<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="globetrotter.Dashboard" owl="1">
        <div class="o_globetrotter_dashboard">
            <div class="o_globetrotter_dashboard_header">
                <div>
                    <p class="o_globetrotter_eyebrow">TRAVEL PLANNING</p>
                    <h1>GlobeTrotter Dashboard</h1>
                    <p class="o_globetrotter_subtitle">A live view of your travel plans and destinations.</p>
                </div>
                <button class="btn btn-primary" t-on-click="() => this.openModel('globetrotter.trip')">
                    <i class="fa fa-plus me-2"/>New Trip
                </button>
            </div>

            <t t-if="state.loading">
                <div class="o_globetrotter_loading" role="status">Loading dashboard...</div>
            </t>
            <t t-elif="state.error">
                <div class="alert alert-danger" role="alert">The dashboard could not load its data.</div>
            </t>
            <t t-else="">
                <div class="o_globetrotter_metrics">
                    <button class="o_globetrotter_metric o_metric_primary" t-on-click="() => this.openModel('globetrotter.trip')">
                        <span class="o_metric_icon"><i class="fa fa-map-signs"/></span>
                        <span class="o_metric_label">Total Trips</span>
                        <strong t-esc="state.metrics.totalTrips"/>
                    </button>
                    <button class="o_globetrotter_metric" t-on-click="() => this.openModel('globetrotter.city')">
                        <span class="o_metric_icon"><i class="fa fa-map-marker"/></span>
                        <span class="o_metric_label">Cities</span>
                        <strong t-esc="state.metrics.totalCities"/>
                    </button>
                    <button class="o_globetrotter_metric" t-on-click="() => this.openModel('globetrotter.trip.stop')">
                        <span class="o_metric_icon"><i class="fa fa-location-arrow"/></span>
                        <span class="o_metric_label">Trip Stops</span>
                        <strong t-esc="state.metrics.totalStops"/>
                    </button>
                    <button class="o_globetrotter_metric" t-on-click="() => this.openModel('globetrotter.trip.stop')">
                        <span class="o_metric_icon"><i class="fa fa-calendar"/></span>
                        <span class="o_metric_label">Planned Days</span>
                        <strong t-esc="state.metrics.totalDays"/>
                    </button>
                </div>

                <div class="o_globetrotter_columns">
                    <section class="o_globetrotter_panel">
                        <div class="o_panel_heading">
                            <div><p class="o_globetrotter_eyebrow">STATUS OVERVIEW</p><h2>Trip pipeline</h2></div>
                            <button class="btn btn-link" t-on-click="() => this.openModel('globetrotter.trip')">View all <i class="fa fa-arrow-right ms-1"/></button>
                        </div>
                        <div class="o_status_rows">
                            <button class="o_status_row" t-on-click="() => this.openModel('globetrotter.trip', [['state', '=', 'draft']])"><span><i class="fa fa-pencil"/> Draft</span><strong t-esc="state.metrics.draftTrips"/></button>
                            <button class="o_status_row" t-on-click="() => this.openModel('globetrotter.trip', [['state', '=', 'planned']])"><span><i class="fa fa-clock-o"/> Planned</span><strong t-esc="state.metrics.plannedTrips"/></button>
                            <button class="o_status_row" t-on-click="() => this.openModel('globetrotter.trip', [['state', '=', 'completed']])"><span><i class="fa fa-check-circle"/> Completed</span><strong t-esc="state.metrics.completedTrips"/></button>
                            <button class="o_status_row" t-on-click="() => this.openModel('globetrotter.trip', [['state', '=', 'cancelled']])"><span><i class="fa fa-ban"/> Cancelled</span><strong t-esc="state.metrics.cancelledTrips"/></button>
                        </div>
                    </section>

                    <section class="o_globetrotter_panel o_recent_panel">
                        <div class="o_panel_heading">
                            <div><p class="o_globetrotter_eyebrow">LATEST PLANS</p><h2>Recent trips</h2></div>
                        </div>
                        <t t-if="!state.recentTrips.length">
                            <div class="o_empty_state">No trips have been created yet.</div>
                        </t>
                        <t t-else="">
                            <div class="o_recent_trips">
                                <t t-foreach="state.recentTrips" t-as="trip" t-key="trip.id">
                                    <button class="o_recent_trip" t-on-click="() => this.openTrip(trip)">
                                        <span class="o_trip_marker"/>
                                        <span class="o_trip_details"><strong t-esc="trip.name"/><small><t t-esc="formatDate(trip.start_date)"/> to <t t-esc="formatDate(trip.end_date)"/></small></span>
                                        <span class="o_trip_meta"><span t-att-class="'o_trip_state o_state_' + trip.state" t-esc="statusLabel(trip.state)"/><small><t t-esc="trip.stop_count"/> stops</small></span>
                                    </button>
                                </t>
                            </div>
                        </t>
                    </section>
                </div>
            </t>
        </div>
    </t>
</templates>
