<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_globetrotter_city_list" model="ir.ui.view">
		<field name="name">globetrotter.city.list</field>
		<field name="model">globetrotter.city</field>
		<field name="arch" type="xml">
			<list string="Cities">
				<field name="name"/>
				<field name="country_id"/>
				<field name="state_id"/>
				<field name="popularity"/>
				<field name="cost_index"/>
				<field name="active"/>
			</list>
		</field>
	</record>

	<record id="view_globetrotter_city_form" model="ir.ui.view">
		<field name="name">globetrotter.city.form</field>
		<field name="model">globetrotter.city</field>
		<field name="arch" type="xml">
			<form string="City">
				<sheet>
					<field name="image_1920" widget="image" class="oe_avatar"/>
					<group>
						<group>
							<field name="name"/>
							<field name="country_id"/>
							<field name="state_id"/>
						</group>
						<group>
							<field name="latitude"/>
							<field name="longitude"/>
							<field name="popularity"/>
							<field name="cost_index"/>
							<field name="active"/>
						</group>
					</group>
					<field name="description" placeholder="Describe this destination..."/>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_globetrotter_city_search" model="ir.ui.view">
		<field name="name">globetrotter.city.search</field>
		<field name="model">globetrotter.city</field>
		<field name="arch" type="xml">
			<search string="Search Cities">
				<field name="name"/>
				<field name="country_id"/>
				<filter name="active" string="Active" domain="[('active', '=', True)]"/>
			</search>
		</field>
	</record>

	<record id="action_globetrotter_city" model="ir.actions.act_window">
		<field name="name">Cities</field>
		<field name="res_model">globetrotter.city</field>
		<field name="view_mode">list,form</field>
		<field name="search_view_id" ref="view_globetrotter_city_search"/>
	</record>
</odoo>
