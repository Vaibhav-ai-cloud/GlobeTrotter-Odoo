<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_globetrotter_trip_stop_list" model="ir.ui.view">
		<field name="name">globetrotter.trip.stop.list</field>
		<field name="model">globetrotter.trip.stop</field>
		<field name="arch" type="xml">
			<list string="Trip Stops">
				<field name="sequence"/>
				<field name="trip_id"/>
				<field name="city_id"/>
				<field name="arrival_date"/>
				<field name="departure_date"/>
				<field name="duration"/>
			</list>
		</field>
	</record>

	<record id="view_globetrotter_trip_stop_form" model="ir.ui.view">
		<field name="name">globetrotter.trip.stop.form</field>
		<field name="model">globetrotter.trip.stop</field>
		<field name="arch" type="xml">
			<form string="Trip Stop">
				<sheet>
					<group>
						<field name="trip_id"/>
						<field name="city_id"/>
						<field name="sequence"/>
						<field name="arrival_date"/>
						<field name="departure_date"/>
						<field name="duration" readonly="1"/>
					</group>
					<field name="notes" placeholder="Add notes for this stop..."/>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_globetrotter_trip_stop" model="ir.actions.act_window">
		<field name="name">Trip Stops</field>
		<field name="res_model">globetrotter.trip.stop</field>
		<field name="view_mode">list,form</field>
	</record>
</odoo>
