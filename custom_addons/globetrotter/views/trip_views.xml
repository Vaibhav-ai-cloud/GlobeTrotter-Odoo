<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── List View ── -->
    <record id="view_globetrotter_trip_list" model="ir.ui.view">
        <field name="name">globetrotter.trip.list</field>
        <field name="model">globetrotter.trip</field>
        <field name="arch" type="xml">
            <list string="Trips"
                  decoration-success="state == 'completed'"
                  decoration-warning="state == 'planned'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="Trip Name"/>
                <field name="user_id" string="Traveler"/>
                <field name="start_date" string="Departs"/>
                <field name="end_date" string="Returns"/>
                <field name="stop_count" string="Stops"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ── -->
    <record id="view_globetrotter_trip_form" model="ir.ui.view">
        <field name="name">globetrotter.trip.form</field>
        <field name="model">globetrotter.trip</field>
        <field name="arch" type="xml">
            <form string="Trip">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Trip Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Europe Summer 2026"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Trip Details">
                            <field name="user_id" string="Traveler"/>
                            <field name="start_date" string="Departure Date"/>
                            <field name="end_date" string="Return Date"/>
                            <field name="stop_count" readonly="1" string="Number of Stops"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"
                                   placeholder="Describe the trip, highlights, goals…"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="city_id"        string="City"/>
                                    <field name="arrival_date"   string="Arrives"/>
                                    <field name="departure_date" string="Departs"/>
                                    <field name="duration"       readonly="1" string="Days"/>
                                    <field name="notes"          string="Notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ── -->
    <record id="view_globetrotter_trip_search" model="ir.ui.view">
        <field name="name">globetrotter.trip.search</field>
        <field name="model">globetrotter.trip</field>
        <field name="arch" type="xml">
            <search string="Search Trips">
                <field name="name"/>
                <field name="user_id"/>
                <field name="state"/>
                <filter name="my_trips"   string="My Trips"  domain="[('user_id', '=', uid)]"/>
                <filter name="planned"    string="Planned"   domain="[('state', '=', 'planned')]"/>
                <filter name="completed"  string="Completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="By Status"   name="group_by_state"   context="{'group_by': 'state'}"/>
                <filter string="By Traveler" name="group_by_user"    context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_globetrotter_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">globetrotter.trip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_globetrotter_trip_search"/>
    </record>
</odoo>
